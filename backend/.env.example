# ── Database ─────────────────────────────────────────────────────────────────
# Local quick try:     sqlite:///./dev.db
# Docker Compose:      set automatically (see docker-compose.yml)
# Managed Postgres:    postgresql+psycopg://user:pass@host:5432/db?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

WORKSPACE_NAME=TechWiser Web Competitors

# ── Crawling politeness ──────────────────────────────────────────────────────
# Minimum seconds between two requests to the same site.
PER_DOMAIN_DELAY_SECONDS=2
RESPECT_ROBOTS_TXT=true
REQUEST_TIMEOUT_SECONDS=20

# ── Tracking ─────────────────────────────────────────────────────────────────
# How far back a newly added site is imported.
BACKFILL_DAYS=30
# Articles published within this many days are re-read every
# RECHECK_INTERVAL_HOURS to catch edits on sites whose feeds hide them.
RECHECK_RECENT_DAYS=3
RECHECK_INTERVAL_HOURS=6
ENRICH_BATCH_SIZE=60

# ── Worker schedule ──────────────────────────────────────────────────────────
FAST_POLL_MINUTES=15
SITEMAP_SWEEP_MINUTES=360
ENRICH_MINUTES=2
MANUAL_REFRESH_COOLDOWN_SECONDS=120
# Each poll also reads every child sitemap updated on the latest date.
LATEST_SITEMAPS_ON_POLL=true
LATEST_SITEMAPS_MAX_CHILDREN=20

# ── Production (Render) ──────────────────────────────────────────────────────
# OPTIONAL team password. Empty (default) = no login screen. Set it (plus
# SESSION_SECRET) to switch the login back on.
DASHBOARD_PASSWORD=
# Signs login cookies (only used when DASHBOARD_PASSWORD is set).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_DAYS=30
# Run the tracker worker inside the API process (one service instead of two).
# Only with a single uvicorn worker.
EMBEDDED_WORKER=false

# ── Storage housekeeping & connection pool ───────────────────────────────────
# Delete articles with no activity for N days (0 = keep forever). Use ~180 on
# the free 500 MB Supabase database.
RETENTION_DAYS=0
JOB_LOG_RETENTION_DAYS=30
# Postgres connection pool. Keep small (3/2) on Supabase's free shared pooler.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── YouTube (Phase 3) ────────────────────────────────────────────────────────
# Google Cloud → APIs & Services → enable "YouTube Data API v3" → Credentials →
# API key. Free quota is 10,000 units/day; each channel uses ~3 per day.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_BUDGET=10000
YOUTUBE_SCRAPE_HOUR_IST=6
OVERPERFORM_RATIO_DEFAULT=2.0
# Community posts via Apify (console.apify.com → Settings → Integrations → API token).
APIFY_API_TOKEN=
APIFY_POSTS_ACTOR_ID=lurkapi/youtube-community-posts-scraper
APIFY_MAX_POSTS_PER_CHANNEL=10
POSTS_SCRAPE_HOUR_IST=7

# ── Alerts & digest (Phase 4) ────────────────────────────────────────────────
# Slack: api.slack.com/apps → Create app → Incoming Webhooks → add to a channel.
SLACK_WEBHOOK_URL=
# Telegram: talk to @BotFather → /newbot → token; add the bot to your group and
# read the chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_CHECK_MINUTES=5
DIGEST_ENABLED=true
DIGEST_HOUR_IST=9
DIGEST_MINUTE_IST=30
# Used to build links inside alert messages.
DASHBOARD_URL=http://localhost:8443

# ── Optional techwiser.com benchmark ─────────────────────────────────────────
# A Google Cloud service account (JSON key pasted as one line) that has been
# added as a user in Search Console and as a Viewer in GA4.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:techwiser.com
GA4_PROPERTY_ID=
