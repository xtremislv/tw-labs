# Builds the React/Vite dashboard and serves it as static files via nginx,
# which also reverse-proxies /api and /healthz to the backend container so
# the browser only ever talks to one origin (no CORS juggling in prod).
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# VITE_API_BASE_URL empty string = same-origin requests through nginx's
# /api proxy below (the default and recommended setup for docker-compose).
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
